# El servidor HTTP debe permanecer en loopback. No lo expongas a la red.
SERVER_SECURITY_LISTEN_HOST=127.0.0.1
SERVER_SECURITY_LISTEN_PORT=8765
SERVER_SECURITY_REFRESH_SECONDS=20
SERVER_SECURITY_INITIAL_HISTORY_HOURS=168

# Geolocalización pública mediante ip-api.com. Desactívala si no deseas consultas externas.
SERVER_SECURITY_GEO_LOOKUP=true
SERVER_SECURITY_MAX_GEO_LOOKUPS=100

# Conexión SSH privada al VPS. Usa la IP de Tailscale o el nombre MagicDNS.
SERVER_SECURITY_SSH_HOST=YOUR_VPS_TAILSCALE_IP_OR_MAGICDNS
SERVER_SECURITY_SSH_PORT=22
SERVER_SECURITY_SSH_USER=YOUR_SSH_USER
SERVER_SECURITY_SSH_HOST_KEY=SHA256:REPLACE_WITH_THE_VERIFIED_SERVER_HOST_KEY
SERVER_SECURITY_SSH_KEY_PATH=C:\path\to\your-private-key.ppk
SERVER_SECURITY_PLINK_PATH=C:\Program Files\PuTTY\plink.exe
SERVER_SECURITY_PAGEANT_PATH=C:\Program Files\PuTTY\pageant.exe

# Opcional: direcciones separadas por coma que no deben contarse como accesos SSH críticos.
SERVER_SECURITY_TRUSTED_SSH_IPS=

# Opcional: generación y descarga de reportes SSH.
SERVER_SECURITY_REPORT_REMOTE_DIR=/var/lib/server-security/reports
SERVER_SECURITY_REPORT_LOCAL_DIR=
SERVER_SECURITY_REPORT_DOWNLOAD_BAT=
SERVER_SECURITY_REPORT_MAX_DAYS=7

# Opcional: ruta de Node.js. node.exe usa el ejecutable disponible en PATH.
SERVER_SECURITY_NODE_PATH=node.exe
