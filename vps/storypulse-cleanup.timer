# Server Security Monitor v2.0
# Created by FacuSecX
# https://github.com/FacuSecX/
[Unit]
Description=Check StoryPulse cleanup schedules every minute

[Timer]
OnCalendar=*-*-* *:*:00
OnBootSec=45s
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=storypulse-cleanup.service

[Install]
WantedBy=timers.target
