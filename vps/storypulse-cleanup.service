# Server Security Monitor v2.0
# Created by FacuSecX
# https://github.com/FacuSecX/
[Unit]
Description=StoryPulse scheduled security log cleanup
After=systemd-journald.service time-sync.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/storypulse-securityctl cleanup-tick
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
