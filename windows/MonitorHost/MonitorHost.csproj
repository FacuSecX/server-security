<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FacuSecX.MonitorHost</AssemblyName>
    <Title>Server Monitor</Title>
    <AssemblyTitle>Server Monitor</AssemblyTitle>
    <Product>Server Monitor</Product>
    <Description>Server Monitor</Description>
    <Company>FacuSecX</Company>
    <Version>3.0.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>server-monitor.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="server-monitor.ico" LogicalName="ServerMonitor.Icon" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
